[
  // ==============================================================================
  // TextCraft / Scheme Strict Paredit 专属极速快捷键 (参考 docs/strict_paredit_guide.md)
  // 核心哲学: 纯单发 (One-Shot), 避开浏览器冲突, 限定 editorLangId == 'scheme'
  // ==============================================================================

  // 1. 向外扩选 (Expand): 严丝合缝选中当前 (...)，连按扩大一层括号
  {
    "key": "alt+shift+i",
    "command": "paredit.sexpRangeExpansion",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 2. 发射求值 (Eval REPL): 将当前选中代码送入活跃终端运行
  {
    "key": "ctrl+enter",
    "command": "workbench.action.terminal.runSelectedText",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 3. 圆括号包裹 (Wrap Parens): cards -> (cards)
  {
    "key": "alt+shift+w",
    "command": "paredit.wrapAroundParens",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 4. 方括号包裹 (Wrap Square): x 10 -> [x 10]
  {
    "key": "alt+shift+u",
    "command": "paredit.wrapAroundSquare",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 5. 向右吞噬 (Slurp): (a b) c -> (a b c)
  {
    "key": "alt+shift+h",
    "command": "paredit.slurpSexpForward",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 6. 向左吐出 (Barf): (a b c) -> (a b) c
  {
    "key": "alt+shift+j",
    "command": "paredit.barfSexpForward",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 7. 向内收缩 (Contract): 选区向内收缩一级
  {
    "key": "alt+shift+k",
    "command": "paredit.sexpRangeContraction",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 8. 选中顶级函数 (Defun): 一键选中最外层整个 (define ...)
  {
    "key": "alt+3",
    "command": "paredit.rangeForDefun",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 9. 脱壳解包 (Splice): (let () (expr)) -> (expr)
  {
    "key": "alt+shift+l",
    "command": "paredit.spliceSexp",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 10. 大步前进 (Forward): 光标跨过右侧整组完整 S-表达式
  {
    "key": "alt+1",
    "command": "paredit.forwardSexp",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 11. 大步后退 (Backward): 光标跨过左侧整组完整 S-表达式
  {
    "key": "alt+2",
    "command": "paredit.backwardSexp",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 12. 深度钻入 (Down): 跳进当前括号内部最左侧第一个参数前
  {
    "key": "alt+q",
    "command": "paredit.forwardDownSexp",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 13. 向上跳出 (Up): 跳到当前外层括号左侧前置位
  {
    "key": "alt+w",
    "command": "paredit.backwardUpSexp",
    "when": "editorTextFocus && editorLangId == 'scheme'"
  },

  // 14. 向后整块删除 (Kill Sexp): 删掉光标右侧的一整组完整子表达式（不破坏括号）
  {
    "key": "alt+u",
    "command": "paredit.killSexpForward",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 15. 智能格式排版 (Indent): 一键对齐当前 S 表达式代码块
  {
    "key": "alt+i",
    "command": "paredit.indentRange",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 16. 相邻参数对调 (Transpose): (equal? a b) -> (equal? b a)
  {
    "key": "alt+h",
    "command": "paredit.transpose",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  },

  // 17. 列表切分 (Split): (a b | c d) -> (a b) (c d)
  {
    "key": "alt+j",
    "command": "paredit.splitSexp",
    "when": "editorTextFocus && !editorReadOnly && editorLangId == 'scheme'"
  }
]
